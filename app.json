{
  "expo": {
    "name": "Visionary Hub",
    "slug": "visionary-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.visionary.app",
      "infoPlist": {
        "NSCameraUsageDescription": "We need access to your camera to scan QR codes during check-in",
        "NSPhotoLibraryUsageDescription": "We need access to your photos for profile pictures"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111226"
      },
      "package": "com.visionary.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access Face ID"
        }
      ],
      "expo-sqlite"
    ],
    "scheme": "visionary",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b805799-2f19-4e74-adaf-6759647280d1"
      }
    }
  }
}
